.DS_Store
*.swp
*.swo

# Python bytecode (never commit)
__pycache__/
*.py[cod]
*$py.class

# Never commit .git internals copied into the repo root
/config
/description
/HEAD
/index
/packed-refs
/refs/
/objects/
/logs/
/info/
/hooks/

# Local MCP overrides (machine-specific; see mcps/mcps.local.yaml.example)
mcps.local.yaml
**/mcps.local.yaml

# Local install config + private team data (nested git — never commit to core)
config.local.yaml
**/config.local.yaml
team/
.gitmodules

# Legacy — learnings belong in team/ only (never in Core)
learnings/
