#!/usr/bin/env bash
# shared-agents CLI — Usage: sa help
set -euo pipefail

SHARED_AGENTS_HOME="${SHARED_AGENTS_HOME:-$HOME/.shared-agents}"
SA_VERSION="0.3.2"
SA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=sa-ui.sh
source "$SA_DIR/sa-ui.sh"
SA_REPO_ROOT="$(cd "$SA_DIR/.." && pwd)"
DEFAULT_GIT_REMOTE="${SHARED_AGENTS_GIT_REMOTE:-git@bitbucket.org:netgrade/shared-agents.git}"

# Prefer scripts next to this sa (repo checkout); fall back to ~/.shared-agents
_sa_script() {
  local name="$1"
  if [[ -f "$SA_DIR/$name" ]]; then
    echo "$SA_DIR/$name"
  else
    echo "$SHARED_AGENTS_HOME/scripts/$name"
  fi
}

_sa_bin() {
  _sa_script "$1"
}

_sa_resolve_install_sh() {
  # Dev: ./sa from repo → use repo install.sh (not stale ~/.shared-agents copy)
  if [[ "$SA_REPO_ROOT" != "$SHARED_AGENTS_HOME" && -f "$SA_REPO_ROOT/install.sh" ]]; then
    echo "$SA_REPO_ROOT/install.sh"
  elif [[ -f "$SHARED_AGENTS_HOME/install.sh" ]]; then
    echo "$SHARED_AGENTS_HOME/install.sh"
  elif [[ -f "$SA_REPO_ROOT/install.sh" ]]; then
    echo "$SA_REPO_ROOT/install.sh"
  fi
}

_sa_resolve_uninstall_sh() {
  if [[ "$SA_REPO_ROOT" != "$SHARED_AGENTS_HOME" && -f "$SA_REPO_ROOT/uninstall.sh" ]]; then
    echo "$SA_REPO_ROOT/uninstall.sh"
  elif [[ -f "$SHARED_AGENTS_HOME/uninstall.sh" ]]; then
    echo "$SHARED_AGENTS_HOME/uninstall.sh"
  elif [[ -f "$SA_REPO_ROOT/uninstall.sh" ]]; then
    echo "$SA_REPO_ROOT/uninstall.sh"
  fi
}

_sa_home_missing() {
  [[ ! -d "$SHARED_AGENTS_HOME" ]]
}

_sa_require_home() {
  if _sa_home_missing; then
    if SA_VERSION="$SA_VERSION" _sa_ui_py --error \
        "shared-agents not found at: $SHARED_AGENTS_HOME" \
        "Run: sa install   (or: shared-agents install)" 2>/dev/null; then
      :
    else
      echo "shared-agents not found at: $SHARED_AGENTS_HOME" >&2
      echo "Run: sa install   (or: shared-agents install)" >&2
    fi
    exit 1
  fi
}

_sa_run_install() {
  local install_sh
  install_sh="$(_sa_resolve_install_sh)"
  if [[ -n "$install_sh" ]]; then
    exec "$install_sh" "$@"
  fi

  if _sa_home_missing; then
    echo "Bootstrapping $SHARED_AGENTS_HOME from $DEFAULT_GIT_REMOTE"
    mkdir -p "$(dirname "$SHARED_AGENTS_HOME")"
    git clone "$DEFAULT_GIT_REMOTE" "$SHARED_AGENTS_HOME"
    if [[ -f "$SHARED_AGENTS_HOME/scripts/ensure-git-remote.sh" ]]; then
      bash "$SHARED_AGENTS_HOME/scripts/ensure-git-remote.sh" "$SHARED_AGENTS_HOME"
    fi
  fi

  exec "$SHARED_AGENTS_HOME/install.sh" "$@"
}

sa_help() {
  SA_VERSION="$SA_VERSION" SHARED_AGENTS_HOME="$SHARED_AGENTS_HOME" \
    _sa_ui_py --help
}

sa_version() {
  local install_sh=""
  local install_hint=""
  install_sh="$(_sa_resolve_install_sh)"
  if [[ -n "$install_sh" ]]; then
    export SA_INSTALL_SH="$install_sh"
    unset SA_INSTALL_HINT
  elif _sa_home_missing; then
    export SA_INSTALL_HINT="install.sh=(bootstrap via sa install)"
    unset SA_INSTALL_SH
  else
    unset SA_INSTALL_SH SA_INSTALL_HINT
  fi
  SA_VERSION="$SA_VERSION" SHARED_AGENTS_HOME="$SHARED_AGENTS_HOME" \
    _sa_ui_py --version
}

dispatch() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    help|-h|--help)
      sa_help
      ;;
    version|-V|--version)
      sa_version
      ;;
    install|setup)
      _sa_run_install "$@"
      ;;
    bootstrap)
      local bw="$(_sa_script bootstrap_wizard.py)"
      if [[ ! -f "$bw" ]]; then
        _sa_run_install --bootstrap "$@"
      else
        if _sa_home_missing; then
          export SHARED_AGENTS_CORE_REMOTE="${SHARED_AGENTS_CORE_REMOTE:-$DEFAULT_GIT_REMOTE}"
        fi
        exec python3 "$bw" \
          --source "$SA_REPO_ROOT" \
          --home "$SHARED_AGENTS_HOME" \
          "$@"
      fi
      ;;
    check)
      local install_sh
      install_sh="$(_sa_resolve_install_sh)"
      if [[ -n "$install_sh" ]]; then
        exec "$install_sh" --check "$@"
      fi
      _sa_require_home
      exec "$(_sa_bin install.sh)" --check "$@"
      ;;
    sync)
      _sa_require_home
      exec "$(_sa_bin sync.sh)" pull "$@"
      ;;
    status|remind|inbox)
      _sa_require_home
      exec python3 "$(_sa_bin sa-status.py)" "$@"
      ;;
    uninstall)
      local uninstall_sh
      uninstall_sh="$(_sa_resolve_uninstall_sh)"
      if [[ -z "$uninstall_sh" ]]; then
        echo "Nothing to uninstall — $SHARED_AGENTS_HOME not configured." >&2
        exit 0
      fi
      exec "$uninstall_sh" "$@"
      ;;
    path)
      _sa_require_home
      exec "$(_sa_bin learning-path.sh)" "$@"
      ;;
    review)
      _sa_require_home
      if [[ $# -eq 0 ]]; then
        exec "$(_sa_bin review-learning.sh)"
      fi
      case "$1" in
        list|ls)
          shift
          exec "$(_sa_bin review-learning.sh)" --list "$@"
          ;;
        dry)
          shift
          exec "$(_sa_bin review-learning.sh)" --dry-run "$@"
          ;;
        *)
          exec "$(_sa_bin review-learning.sh)" "$@"
          ;;
      esac
      ;;
    team)
      _sa_require_home
      local sub="${1:-}"
      shift || true
      case "$sub" in
        migrate)
          exec python3 "$(_sa_script team_data.py)" migrate "$SHARED_AGENTS_HOME" "$@"
          ;;
        verify)
          exec python3 "$(_sa_script team_data.py)" verify "$SHARED_AGENTS_HOME" "$@"
          ;;
        "")
          echo "Usage: sa team verify [--json] [--strict]" >&2
          echo "       sa team migrate [--dry-run]" >&2
          exit 1
          ;;
        *)
          echo "Unknown: sa team $sub" >&2
          echo "Try: sa team verify | sa team migrate" >&2
          exit 1
          ;;
      esac
      ;;
    pending)
      _sa_require_home
      local sub="${1:-push}"
      shift || true
      case "$sub" in
        push|publish)
          exec "$(_sa_bin publish-pending-learning.sh)" "$@"
          ;;
        path)
          exec "$(_sa_bin learning-path.sh)" "$@"
          ;;
        *)
          echo "Unknown: sa pending $sub" >&2
          echo "Try: sa pending push [file] | sa pending path [slug]" >&2
          exit 1
          ;;
      esac
      ;;
    unapprove|rm)
      _sa_require_home
      if [[ $# -eq 0 ]]; then
        exec "$(_sa_bin unapprove-learning.sh)"
      fi
      case "$1" in
        list|ls)
          shift
          exec "$(_sa_bin unapprove-learning.sh)" --list "$@"
          ;;
        *)
          exec "$(_sa_bin unapprove-learning.sh)" "$@"
          ;;
      esac
      ;;
    skill)
      _sa_require_home
      local sub="${1:-new}"
      shift || true
      case "$sub" in
        new)
          exec python3 "$(_sa_script team_content_wizard.py)" skill new \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        rm|delete|remove)
          exec python3 "$(_sa_script team_content_wizard.py)" skill rm \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        list|ls)
          exec python3 "$(_sa_script team_content_wizard.py)" skill list \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        *)
          echo "Usage: sa skill new|rm|list [opts]" >&2
          echo "Try: sa skill new --help" >&2
          exit 1
          ;;
      esac
      ;;
    rule)
      _sa_require_home
      local sub="${1:-new}"
      shift || true
      case "$sub" in
        new)
          exec python3 "$(_sa_script team_content_wizard.py)" rule new \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        rm|delete|remove)
          exec python3 "$(_sa_script team_content_wizard.py)" rule rm \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        list|ls)
          exec python3 "$(_sa_script team_content_wizard.py)" rule list \
            --home "$SHARED_AGENTS_HOME" "$@"
          ;;
        *)
          echo "Usage: sa rule new|rm|list [opts]" >&2
          echo "Try: sa rule new --help" >&2
          exit 1
          ;;
      esac
      ;;
    *)
      _sa_ui_py --error "Unknown command: sa $cmd" "Run: sa help" >&2 || {
        echo "Unknown command: sa $cmd" >&2
        echo "Run: sa help" >&2
      }
      exit 1
      ;;
  esac
}

dispatch "$@"
